# systemd user unit (Linux / X11).
# Install: cp contrib/ember.service ~/.config/systemd/user/ && systemctl --user enable --now ember
[Unit]
Description=Ember screen colour temperature
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.cargo/bin/ember run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
